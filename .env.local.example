# Google AI Studio (aistudio.google.com/apikey) — the free-tier alternative.
# Free-tier quotas are per-day and per-minute and Google changes them; check
# the current numbers before relying on this in production.
#
# Read this before pointing production here: on the free tier Google may use
# submitted prompts to improve its products. The payload is a visitor's
# description of their own bottleneck, sent from a public marketing page.
# Low-sensitivity, but it is a third-party disclosure — a paid Anthropic key
# is the answer if that's not acceptable.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
#
# Check the free-tier daily cap before picking one — it varies wildly by model
# and it is per-model, not per-key. gemini-3.6-flash allows only 20 requests
# PER DAY on the free tier (the 429 names the metric: GenerateRequestsPerDay),
# which is not enough to serve a public panel; the -lite models are far more
# generous. Once the cap is hit every visitor silently gets a static scope from
# lib/scope/static-scopes.ts, so this setting decides how often the live path
# actually runs.
GEMINI_MODEL=
# Optional. "anthropic" or "gemini" to pin one explicitly and ignore the
# key-presence order above.
SCOPE_PROVIDER=

# --- Supabase — lead + scope logging (ARCHITECTURE §4) ---------------------
# Project URL is safe to expose; the service role key absolutely is not —
# it bypasses row-level security. Server-side route handlers only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis — rate limiting for the public /api/scope endpoint ------
# Without this, an unauthenticated public endpoint calling a paid API has no
# cost ceiling. Required before Phase 6 ships.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend — transactional email (lead notifications, scope-to-email) -----
RESEND_API_KEY=
# Optional. From-address for the "send me this scope" email; must be on a
# domain verified in Resend. Defaults to "ANTA <anadit@theanta.com>".
RESEND_FROM=

# --- IP hashing -----------------------------------------------------------
# Optional salt for the ip_hash column on scope_submissions (lib/scope/
# ratelimit.ts). Any long random string. Falls back to the Supabase service
# role key, so this only needs setting if you'd rather the two not be linked.
IP_HASH_SALT=

# --- Analytics ------------------------------------------------------------
# Existing GA4 property, ported forward from the live repo — do not create a
# new one. Public by design (it ends up in the page anyway). Committed as a
# default in app/layout.tsx; set here only to override locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BF6M3EFFKH

# --- Search Console -------------------------------------------------------
# The verification code from Google Search Console's HTML-tag method — just
# the `content` value, not the whole <meta> tag. app/layout.tsx emits the tag
# only when this is set, so an unset value ships no tag rather than an empty
# one (GSC treats an empty content attribute as a failed verification, which
# is worse than absent).
#
# Read at build time: set it in Vercel Production, redeploy, then click
# Verify in Search Console and submit https://theanta.com/sitemap.xml.
GOOGLE_SITE_VERIFICATION=

# --- Sentry — error tracking ----------------------------------------------
# Wired but dormant: instrumentation.ts and sentry.*.config.ts key off the
# DSN, so with these unset nothing initialises and nothing is sent. Setting
# the DSN alone is enough to start capturing errors.
#
# The DSN is public by design (it ships in the client bundle). Set the
# NEXT_PUBLIC_ one; the bare SENTRY_DSN is only a server-side override.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
#
# The three below are build-time only, and only for readable stack traces
# through minified code. next.config.ts applies the Sentry build plugin
# *only* when SENTRY_ORG and SENTRY_PROJECT are both present, so leaving
# them blank keeps builds quiet. The auth token is a real secret — Vercel
# only, never here with a value in it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Vercel Analytics / Speed Insights ------------------------------------
# No env vars. Both are mounted in app/layout.tsx and activate automatically
# on a Vercel deployment — but only once enabled in the Vercel project's
# Analytics and Speed Insights tabs. Nothing to set here; noted so the
# absence doesn't read as an oversight.
