# Copy to .env.local (gitignored) and fill in. Nothing here belongs in the
# repo — see ARCHITECTURE.md §6. In production these live only in Vercel
# project settings, set for the Production environment, not just Preview.
#
# Every secret is listed here even before it's wired up, specifically so
# nothing gets hardcoded later "just for now."
#
# Rule: NEXT_PUBLIC_* is shipped to the browser and is readable by anyone.
# Only put a value there if it is genuinely safe to expose.

# --- Anthropic — "Scope it live" (BUILD_PLAN Phase 6) -----------------------
# Server-side only. Never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Supabase — lead + scope logging (ARCHITECTURE §4) ---------------------
# Project URL is safe to expose; the service role key absolutely is not —
# it bypasses row-level security. Server-side route handlers only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis — rate limiting for the public /api/scope endpoint ------
# Without this, an unauthenticated public endpoint calling a paid API has no
# cost ceiling. Required before Phase 6 ships.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend — transactional email (lead notifications, scope-to-email) -----
RESEND_API_KEY=

# --- Analytics ------------------------------------------------------------
# Existing GA4 property, ported forward from the live repo — do not create a
# new one. Public by design (it ends up in the page anyway). Committed as a
# default in app/layout.tsx; set here only to override locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BF6M3EFFKH

# --- Sentry (BUILD_PLAN Phase 5+) -----------------------------------------
# DSN is public by design; the auth token (source map upload at build time)
# is not.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
